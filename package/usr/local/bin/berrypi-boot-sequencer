#!/usr/bin/env bash

LOG_FILE="/var/log/berrypi-sequencer.log"
STAMP_DIR="/run/berrypi-sequencer"
REPORT_DIR="/run/omv-agent"
REPORT_FILE="${REPORT_DIR}/boot_report.json"
BOOT_ID_FILE="/proc/sys/kernel/random/boot_id"
EVEBOX_BASE="/srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox"
EVEBOX_DATA="/srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data"

timestamp() {
  date --iso-8601=seconds
}

log_msg() {
  printf '%s %s\n' "$(timestamp)" "$*" >>"${LOG_FILE}"
}

json_escape() {
  local value="${1:-}"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

read_boot_id() {
  cat "${BOOT_ID_FILE}"
}

os_pretty_name() {
  local pretty_name="unknown"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    pretty_name="${PRETTY_NAME:-unknown}"
  fi
  printf '%s' "${pretty_name}"
}

service_state() {
  systemctl is-active "$1" 2>/dev/null || true
}

eth1_state() {
  if ip link show eth1 2>/dev/null | grep -q UP; then
    printf 'up'
  else
    printf 'down'
  fi
}

eth2_state() {
  if ip link show eth2 2>/dev/null | grep -q PROMISC; then
    printf 'PROMISC'
  else
    printf 'unknown'
  fi
}

evebox_state() {
  docker inspect evebox --format='{{.State.Status}}' 2>/dev/null || echo unknown
}

write_report() {
  local status="$1"
  local message="$2"
  local failed_group="${3:-}"
  local boot_id
  local report_tmp

  boot_id="$(read_boot_id)"
  mkdir -p "${REPORT_DIR}"
  report_tmp="$(mktemp "${REPORT_DIR}/boot_report.json.XXXXXX")"

  {
    printf '{\n'
    printf '  "status": "%s",\n' "$(json_escape "${status}")"
    printf '  "message": "%s",\n' "$(json_escape "${message}")"
    if [[ -n "${failed_group}" ]]; then
      printf '  "failed_group": "%s",\n' "$(json_escape "${failed_group}")"
    fi
    printf '  "timestamp": "%s",\n' "$(json_escape "$(timestamp)")"
    printf '  "boot_id": "%s",\n' "$(json_escape "${boot_id}")"
    printf '  "os_version": "%s",\n' "$(json_escape "$(os_pretty_name)")"
    printf '  "kernel": "%s",\n' "$(json_escape "$(uname -r)")"
    printf '  "services": {\n'
    printf '    "bcache_wb": "off",\n'
    printf '    "unbound": "%s",\n' "$(json_escape "$(service_state unbound)")"
    printf '    "pihole_ftl": "%s",\n' "$(json_escape "$(service_state pihole-FTL)")"
    printf '    "eth0": "down",\n'
    printf '    "eth1": "%s",\n' "$(json_escape "$(eth1_state)")"
    printf '    "eth2": "%s",\n' "$(json_escape "$(eth2_state)")"
    printf '    "suricata": "%s",\n' "$(json_escape "$(service_state suricata)")"
    printf '    "evebox": "%s"\n' "$(json_escape "$(evebox_state)")"
    printf '  }\n'
    printf '}\n'
  } >"${report_tmp}"

  chmod 0644 "${report_tmp}"
  mv -f "${report_tmp}" "${REPORT_FILE}"
}

group_a_bcache() {
  sudo bcache-wb off
}

group_b_network() {
  sudo ip link set eth0 down &&
  sudo ip link set eth2 down &&
  sudo ip addr flush dev eth2 &&
  sudo ip link set eth2 promisc on &&
  sudo ip link set eth2 up
}

group_c_systemd_reload() {
  sudo systemctl daemon-reexec &&
  sudo systemctl daemon-reload
}

group_d_dns() {
  sudo service unbound restart &&
  sudo unbound-control reload &&
  sudo service unbound restart &&
  sudo systemctl restart pihole-FTL &&
  sudo systemctl restart systemd-resolved &&
  sudo chattr +i /etc/resolv.conf
}

group_e_suricata() {
  sudo systemctl daemon-reexec &&
  sudo systemctl daemon-reload &&
  sudo suricata-update &&
  sudo systemctl restart suricata
}

group_f_evebox() {
  mkdir -p /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data &&
  sudo chown -R 1000:1000 /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data &&
  sudo chmod -R 755 /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox &&
  sudo chown -R pi:pi /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data &&
  docker run --rm -v /var/log/suricata:/logs:ro jasonish/evebox evebox oneshot /logs/eve.json > /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data/events.sqlite &&
  sudo rm -f /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data/*.sqlite-shm /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data/*.sqlite-wal &&
  docker run -d --name evebox --restart unless-stopped -p 10.7.12.8:7036:5636 -v /var/log/suricata:/logs:ro -v /srv/dev-disk-by-uuid-f9da6d25-a755-4ea2-991c-1fd0e91000b6/System_log/evebox/evebox_data:/var/lib/evebox jasonish/evebox /usr/bin/evebox server --datastore sqlite --input /logs/eve.json
}

run_group() {
  local group_name="$1"
  local function_name="$2"

  log_msg "START ${group_name}"
  if "${function_name}"; then
    log_msg "SUCCESS ${group_name}"
  else
    log_msg "FAILURE ${group_name}"
    write_report "failure" "Boot sequence failed in ${group_name}" "${group_name}"
    return 1
  fi
}

run_sequence() {
  set -euo pipefail

  run_group "GROUP A - bcache" group_a_bcache
  run_group "GROUP B - Network" group_b_network
  run_group "GROUP C - Systemd reload" group_c_systemd_reload
  run_group "GROUP D - DNS" group_d_dns
  run_group "GROUP E - Suricata" group_e_suricata
  run_group "GROUP F - Evebox" group_f_evebox

  write_report "success" "Success booting up, all systems are working"
  log_msg "SUCCESS all groups complete"
}

claim_stamp() {
  local boot_id="$1"
  local stamp="${STAMP_DIR}/ran_${boot_id}"
  local tmp_stamp

  mkdir -p "${STAMP_DIR}"
  tmp_stamp="$(mktemp "${STAMP_DIR}/.ran_${boot_id}.XXXXXX")"
  printf '%s\n' "$(timestamp)" >"${tmp_stamp}"
  if ln "${tmp_stamp}" "${stamp}" 2>/dev/null; then
    rm -f "${tmp_stamp}"
    return 0
  fi
  rm -f "${tmp_stamp}"
  return 1
}

run_once_for_boot() {
  local boot_id
  boot_id="$(read_boot_id)"

  if ! claim_stamp "${boot_id}"; then
    log_msg "SKIP boot_id=${boot_id} already stamped"
    return 0
  fi

  log_msg "CLAIM boot_id=${boot_id}"
  run_sequence
}

main() {
  if [[ "${1:-}" == "--systemd" ]]; then
    set -euo pipefail
    run_sequence
    return
  fi

  if [[ -z "${SSH_CONNECTION:-}" ]]; then
    exit 0
  fi

  (
    set -euo pipefail
    run_once_for_boot
  ) >>"${LOG_FILE}" 2>&1 &
}

main "$@"
