#!/bin/bash
set -e

case "$1" in
  purge)
    # Remove runtime data only on purge
    rm -rf /var/lib/omv-agent
    echo "OMV Agent: runtime data purged."
    ;;
  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
